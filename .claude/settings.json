{
  "attribution": { "commit": "", "pr": "" },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/skills/run-ntr-extension/st.sh\" hook" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard.mjs\"", "if": "Bash(git *)", "timeout": 30, "onFailure": "block" }
        ]
      },
      {
        "matcher": "mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/commit-guard.mjs\"", "timeout": 30, "onFailure": "block" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-tests.mjs\"", "timeout": 150 }
        ]
      }
    ]
  }
}
